      "allowed_roles": [
        "distributed_observer",
        "operations_coordinator"
      ],
      "capability": "resilience",
      "reversible": true
    },
    {
      "id": "compare-rival-hypotheses",
      "title": "対立仮説を同じ証拠で再計算する",
      "allowed_roles": [
        "evidence_steward",
        "failure_analyst",
        "civic_challenger"
      ],
      "capability": "audit",
      "reversible": true
    },
    {
      "id": "exercise-anomaly-handoff",
      "title": "観測不一致と停止の引継ぎ訓練を行う",
      "allowed_roles": [
        "operations_coordinator",
        "civic_challenger",
        "distributed_observer"
      ],
      "capability": "operations",
      "reversible": true
    },
    {
      "id": "audit-common-cause-failure",
      "title": "共通原因故障と誤警報を監査する",
      "allowed_roles": [
        "failure_analyst",
        "distributed_observer"
      ],
      "capability": "safety",
      "reversible": true
    }
  ],
  "node_requirements": {
